# data and model weights are fetched by scripts/download_data.py, not versioned
# (16 MB catalog, 169 MB embeddings, 17 MB checkpoint)
data/*.parquet
checkpoints/

# local bundle of the two data files plus checksums; kept out of git so the repo
# stays small (see docs/DATA_CARD.md#data-availability)
release_data/

# regenerated outputs -- the released corpus under benchmark/queries and
# benchmark/tasks is checked in; anything a reproduction run writes is not
benchmark/tasks_generated/
benchmark/queries/*_regenerated_*
logs/

# attribute-extraction cache (resume state, regenerable)
.query_attr_cache_qwen3.json

__pycache__/
*.py[cod]
.ipynb_checkpoints/
wandb/
*.part
